{
  "name": "trustlon",
  "private": true,
  "version": "0.1.0",
  "description": "Trustlon Marketplace monorepo",
  "workspaces": [
    "backend",
    "storefront",
    "super-admin"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run prisma:migrate -w backend --",
    "db:seed": "npm run prisma:seed -w backend",
    "dev:api": "npm run start:dev -w backend",
    "dev:storefront": "npm run dev -w storefront",
    "dev:super-admin": "npm run dev -w super-admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
