/// Pincode master: delivery serviceability and coordinates used for local seller distance.
model Pincode {
  pincode          String   @id @db.Char(6)
  area             String?  @db.VarChar(120)
  /// The district, as India Post lists it; shown as the city on addresses.
  city             String   @db.VarChar(80)
  state            String   @db.VarChar(60)
  latitude         Float?
  longitude        Float?
  serviceable      Boolean  @default(true)
  codAvailable     Boolean  @default(true) @map("cod_available")
  sameDayAvailable Boolean  @default(false) @map("same_day_available")
  deliveryDays     Int      @default(4) @map("delivery_days")
  updatedAt        DateTime @updatedAt @map("updated_at")

  vendors Vendor[]

  @@index([latitude, longitude])
  @@index([city])
  @@map("pincodes")
}

/// Cities and towns outside India for address suggestions, imported from GeoNames
/// (npm run location:cities). Indian cities come from the pincode master.
model City {
  id          Int     @id
  countryCode String  @map("country_code") @db.Char(2)
  name        String  @db.VarChar(120)
  /// Lower-case ASCII name used for prefix search.
  searchName  String  @map("search_name") @db.VarChar(120)
  /// GeoNames first-level region code; not the same as ISO 3166-2.
  regionCode  String? @map("region_code") @db.VarChar(20)
  population  Int     @default(0)

  @@index([countryCode, searchName])
  @@map("cities")
}
