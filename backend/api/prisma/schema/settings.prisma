/// Which channels a customer wants for each kind of message (spec 3.11).
/// `channels` is { [event]: { sms, email, whatsapp, push } }; missing entries use the defaults
/// in settings/notification-preferences.ts. Security messages are always sent.
model NotificationPreference {
  userId    String   @id @map("user_id") @db.Uuid
  channels  Json
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Audit record of a customer deleting their account (DPDP). Personal data on the user row is
/// anonymised; orders, invoices and payments are kept for 8 years as the law requires.
model AccountDeletion {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  reason      String?  @db.VarChar(300)
  /// Orders and payments are retained until this date, then purged by the data-retention job.
  retainUntil DateTime @map("retain_until")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_deletions")
}
