enum WalletEntryType {
  CREDIT
  DEBIT
}

enum WalletEntrySource {
  REFUND
  CASHBACK
  REFERRAL
  ORDER_PAYMENT
  ADJUSTMENT
}

/// Trustlon wallet balance and Trustlon Coins for one customer.
model Wallet {
  userId       String   @id @map("user_id") @db.Uuid
  balancePaise Int      @default(0) @map("balance_paise")
  coins        Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries WalletEntry[]

  @@map("wallets")
}

/// Every change to a wallet. The balance is never edited without an entry.
model WalletEntry {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @map("user_id") @db.Uuid
  type              WalletEntryType
  source            WalletEntrySource
  amountPaise       Int               @default(0) @map("amount_paise")
  coins             Int               @default(0)
  balanceAfterPaise Int               @map("balance_after_paise")
  description       String            @db.VarChar(160)
  /// Order, sub-order or payment reference the entry belongs to.
  reference         String?           @db.VarChar(80)
  createdAt         DateTime          @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("wallet_entries")
}

/// Trustlon Prime membership. Read-only for now; buying a plan arrives with Trustlon Prime (Phase 4).
model PrimeMembership {
  userId      String    @id @map("user_id") @db.Uuid
  plan        String    @db.VarChar(20)
  startedAt   DateTime  @map("started_at")
  endsAt      DateTime  @map("ends_at")
  autoRenew   Boolean   @default(false) @map("auto_renew")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("prime_memberships")
}
