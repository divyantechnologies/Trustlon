enum BannerPlacement {
  /// Main carousel.
  HOME_HERO
  /// Thin sale strip above the hero; `highlights` hold the offer chips.
  HOME_STRIP
  /// Full-width promotional banner between sections.
  HOME_WIDE
  /// Small side advertisements next to product rows.
  HOME_SIDE
}

enum HomeSectionKey {
  HERO_BANNERS
  CATEGORY_TILES
  DEALS_OF_THE_DAY
  TRUSTLON_ORIGINALS
  FEATURED_STORES
  LOCAL_SELLERS
  RECENTLY_VIEWED
  RECOMMENDED
  TRUST_STRIP
}

model Banner {
  id             String          @id @default(uuid()) @db.Uuid
  placement      BannerPlacement @default(HOME_HERO)
  eyebrow        String?         @db.VarChar(60)
  title          String          @db.VarChar(120)
  subtitle       String?         @db.VarChar(240)
  ctaLabel       String          @map("cta_label") @db.VarChar(40)
  imageUrl       String          @map("image_url")
  mobileImageUrl String?         @map("mobile_image_url")
  href           String          @db.VarChar(300)
  /// Small label on the banner image, e.g. a featured product and price.
  tagLabel       String?         @map("tag_label") @db.VarChar(80)
  /// Short chips shown on strip banners, e.g. "SALE 70% · CODE NY70".
  highlights     String[]        @default([])
  priority       Int             @default(0)
  startsAt       DateTime?       @map("starts_at")
  endsAt         DateTime?       @map("ends_at")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([placement, isActive, priority])
  @@map("banners")
}

/// Order and visibility of home page sections, controlled from Admin > Marketing.
model HomeSection {
  key       HomeSectionKey @id
  title     String?        @db.VarChar(80)
  subtitle  String?        @db.VarChar(200)
  isEnabled Boolean        @default(true) @map("is_enabled")
  sortOrder Int            @map("sort_order")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("home_sections")
}

/// Time-boxed price for one product. While active, the deal price is what customers pay.
model Deal {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  dealPricePaise Int      @map("deal_price_paise")
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([startsAt, endsAt])
  @@index([productId])
  @@map("deals")
}

enum CouponType {
  /// `value` is basis points of the order value (1000 = 10%).
  PERCENT
  /// `value` is paise off.
  FLAT
  FREE_DELIVERY
}

enum CouponAudience {
  ALL
  NEW_USERS
  PRIME_MEMBERS
}

/// Trustlon-funded coupon (5.7), managed in Admin › Marketing › Coupons and applied in the cart.
/// It never reduces the vendor's invoice value. Shares the `coupons` table created by the
/// cart/checkout migration; column names are kept so existing coupons carry over.
model Coupon {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String         @unique @db.VarChar(40)
  description      String         @default("") @db.VarChar(200)
  type             CouponType     @default(PERCENT)
  /// PERCENT: basis points (1000 = 10%). FLAT: paise off. FREE_DELIVERY: unused.
  value            Int            @default(0) @map("discount_bps")
  /// Cap on the discount for PERCENT coupons, in paise.
  maxDiscountPaise Int?           @map("max_discount_paise")
  minOrderPaise    Int            @default(0) @map("min_total_paise")
  audience         CouponAudience @default(ALL)
  /// Empty means every category.
  categoryIds      String[]       @default([]) @map("category_ids")
  /// Total redemptions allowed; null means no limit.
  usageLimit       Int?           @map("usage_limit")
  perUserLimit     Int            @default(1) @map("per_user_limit")
  usedCount        Int            @default(0) @map("used_count")
  startsAt         DateTime       @map("starts_at")
  endsAt           DateTime       @map("ends_at")
  isActive         Boolean        @default(true) @map("active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}
