/// Platform settings changed from the admin panel without a deploy (spec 5.9), one row per
/// group (theme, business-rules, payments, shipping, tax, notifications, rewards, features,
/// prime). `value` is validated by site-settings.schema.ts; missing fields use the defaults.
model SiteSetting {
  key         String   @id @db.VarChar(40)
  value       Json
  /// Increases on every save; matches the latest SettingVersion.
  version     Int      @default(0)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

/// Every saved version of a settings group, so any earlier version can be restored (5.9).
model SettingVersion {
  id            String   @id @default(uuid()) @db.Uuid
  group         String   @db.VarChar(40)
  version       Int
  value         Json
  changedById   String?  @map("changed_by_id") @db.Uuid
  changedByName String?  @map("changed_by_name") @db.VarChar(100)
  reason        String?  @db.VarChar(300)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([group, version])
  @@map("setting_versions")
}

/// Storefront text edited from Admin > Settings > Localisation. Overrides the built-in text
/// for one key (e.g. "signup.title") in one language; deleting the row restores it.
model ContentEntry {
  id          String   @id @default(uuid()) @db.Uuid
  language    Language
  key         String   @db.VarChar(200)
  value       String   @db.VarChar(5000)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([language, key])
  @@map("content_entries")
}

/// CMS pages such as About, Terms, Privacy, Returns and Shipping policy (5.7), shown on the
/// storefront at /pages/:slug. The body is simple Markdown.
model CmsPage {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique @db.VarChar(80)
  title       String    @db.VarChar(120)
  body        String
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  updatedById String?   @map("updated_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("cms_pages")
}

enum SeoEntity {
  HOME
  CATEGORY
  PAGE
}

/// Search-engine title and description for a category, CMS page or the home page (5.7).
model SeoMeta {
  id          String    @id @default(uuid()) @db.Uuid
  entity      SeoEntity
  /// Category slug or page slug; "home" for the home page.
  entityKey   String    @map("entity_key") @db.VarChar(160)
  title       String?   @db.VarChar(70)
  description String?   @db.VarChar(170)
  keywords    String?   @db.VarChar(255)
  ogImageUrl  String?   @map("og_image_url") @db.VarChar(300)
  noIndex     Boolean   @default(false) @map("no_index")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([entity, entityKey])
  @@map("seo_meta")
}

/// Old storefront path sent to a new one (5.7), e.g. after a category is renamed.
model Redirect {
  id        String   @id @default(uuid()) @db.Uuid
  fromPath  String   @unique @map("from_path") @db.VarChar(300)
  toPath    String   @map("to_path") @db.VarChar(500)
  permanent Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("redirects")
}
