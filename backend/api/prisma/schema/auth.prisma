enum UserRole {
  CUSTOMER
  VENDOR_OWNER
  VENDOR_STAFF
  BRAND_TEAM
  SUPER_ADMIN
  MARKETING
  SUPPORT
  LOGISTICS
  FINANCE
  CA
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Language {
  EN
  HI
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  RESET_PASSWORD
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  fullName          String     @map("full_name") @db.VarChar(100)
  mobile            String     @unique @db.VarChar(16)
  country           String?    @db.Char(2)
  email             String     @unique @db.VarChar(254)
  passwordHash      String?    @map("password_hash")
  passwordChangedAt DateTime?  @map("password_changed_at")
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(ACTIVE)
  preferredLanguage Language   @default(EN) @map("preferred_language")
  mobileVerifiedAt  DateTime?  @map("mobile_verified_at")
  emailVerifiedAt   DateTime?  @map("email_verified_at")
  referralCode      String     @unique @map("referral_code") @db.VarChar(12)
  referredById      String?    @map("referred_by_id") @db.Uuid
  termsAcceptedAt   DateTime   @map("terms_accepted_at")
  marketingOptIn    Boolean    @default(false) @map("marketing_opt_in")
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at")

  referredBy User?     @relation("UserReferrals", fields: [referredById], references: [id])
  referrals  User[]    @relation("UserReferrals")
  sessions   Session[]

  // Relations owned by other modules (vendors, shopping, orders, wallet).
  vendors         Vendor[]         @relation("VendorOwner")
  cart            Cart?
  wishlistItems   WishlistItem[]
  recentlyViewed  RecentlyViewed[]
  orders          Order[]
  wallet          Wallet?
  primeMembership PrimeMembership?

  @@map("users")
}

model OtpChallenge {
  id          String     @id @default(uuid()) @db.Uuid
  channel     OtpChannel
  target      String     @db.VarChar(254)
  purpose     OtpPurpose
  codeHash    String     @map("code_hash") @db.VarChar(64)
  attempts    Int        @default(0)
  expiresAt   DateTime   @map("expires_at")
  lockedUntil DateTime?  @map("locked_until")
  consumedAt  DateTime?  @map("consumed_at")
  ip          String?    @db.VarChar(45)
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([target, purpose, createdAt])
  @@map("otp_challenges")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @map("token_hash") @db.VarChar(64)
  previousTokenHash String?   @map("previous_token_hash") @db.VarChar(64)
  rotatedAt         DateTime? @map("rotated_at")
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ip                String?   @db.VarChar(45)
  expiresAt         DateTime  @map("expires_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason") @db.VarChar(50)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
