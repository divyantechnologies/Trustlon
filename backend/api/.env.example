NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://trustlon:trustlon@localhost:5432/trustlon?schema=public

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-of-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_TOKEN_TTL_SECONDS=600

OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_RESEND_SECONDS=30

COOKIE_SECURE=false
COOKIE_DOMAIN=
