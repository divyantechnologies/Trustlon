NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://trustlon:trustlon@localhost:5432/trustlon?schema=public

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
OTP_SECRET=change-me-to-another-long-random-string-of-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
VERIFICATION_TOKEN_TTL_SECONDS=600

OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15
OTP_RESEND_SECONDS=30

COOKIE_SECURE=false
COOKIE_DOMAIN=

# Encrypts secrets saved in the database (authenticator apps, payment gateway keys, bank
# accounts). Optional in development, required in production. Never change it once set.
DATA_ENCRYPTION_KEY=
# Where staff open the admin panel.
ADMIN_URL=http://localhost:3001

# Uploaded files (return photos) in local development

# Uploaded files (return photos) in local development
STORAGE_DIR=storage

# India Post lookup for pincodes not yet imported (npm run location:pincodes). Empty = off.
PINCODE_LOOKUP_URL=https://api.postalpincode.in/pincode

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

