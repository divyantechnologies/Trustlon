/// Every action staff take in the admin panel (spec 5.10). Rows are only ever added.
model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  actorId   String?   @map("actor_id") @db.Uuid
  actorName String?   @map("actor_name") @db.VarChar(100)
  actorRole UserRole? @map("actor_role")
  /// What was done, e.g. "vendor.suspend" or "settings.update".
  action    String    @db.VarChar(60)
  /// What it was done to, e.g. "vendor", "order", "settings".
  entity    String    @db.VarChar(40)
  entityId  String?   @map("entity_id") @db.VarChar(120)
  /// Readable name of the entity at the time, e.g. the vendor's name or an order number.
  summary   String?   @db.VarChar(300)
  reason    String?   @db.VarChar(500)
  before    Json?
  after     Json?
  ip        String?   @db.VarChar(45)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

/// Permission matrix for one staff role (5.10), as "module:action" strings such as
/// "vendors:approve". No row means the built-in defaults. Super Admin always has everything.
model RolePermission {
  role        UserRole @id
  permissions String[] @default([])
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("role_permissions")
}

/// Authenticator-app (TOTP) two-factor authentication, mandatory for staff (5.10).
model StaffMfa {
  userId        String    @id @map("user_id") @db.Uuid
  /// Shared secret, encrypted with DATA_ENCRYPTION_KEY.
  secret        String    @db.VarChar(200)
  /// Null until the staff member proves the app works by entering a first code.
  confirmedAt   DateTime? @map("confirmed_at")
  /// Last 30-second time step accepted, so a code cannot be used twice.
  lastUsedStep  Int       @default(0) @map("last_used_step")
  /// SHA-256 hashes of unused one-time recovery codes.
  recoveryCodes String[]  @default([]) @map("recovery_codes")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_mfa")
}

enum ReportTarget {
  PRODUCT
  REVIEW
  VENDOR
}

enum ReportReason {
  COUNTERFEIT
  PROHIBITED
  MISLEADING
  ABUSIVE
  FAKE_REVIEW
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ReporterKind {
  CUSTOMER
  VENDOR
  SYSTEM
}

/// A customer or vendor report about a listing, review or seller (5.8).
model ContentReport {
  id             String       @id @default(uuid()) @db.Uuid
  targetType     ReportTarget @map("target_type")
  targetId       String       @map("target_id") @db.Uuid
  reason         ReportReason
  details        String?      @db.VarChar(1000)
  reporterId     String?      @map("reporter_id") @db.Uuid
  reporterKind   ReporterKind @default(CUSTOMER) @map("reporter_kind")
  status         ReportStatus @default(OPEN)
  /// What staff did, e.g. "delist_product" or "warn_vendor".
  action         String?      @db.VarChar(40)
  resolutionNote String?      @map("resolution_note") @db.VarChar(500)
  handledById    String?      @map("handled_by_id") @db.Uuid
  handledAt      DateTime?    @map("handled_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("content_reports")
}

/// Staff-only note on an order (5.5). Customers and vendors never see these.
model OrderNote {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  authorName String   @map("author_name") @db.VarChar(100)
  body       String   @db.VarChar(1000)
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_notes")
}
