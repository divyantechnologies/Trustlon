enum ReviewStatus {
  PUBLISHED
  UNDER_MODERATION
  REJECTED
}

enum ReviewMediaKind {
  PHOTO
  VIDEO
}

/// A customer's review of one delivered order item. One review per order item.
model Review {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  productId       String       @map("product_id") @db.Uuid
  orderItemId     String       @unique @map("order_item_id") @db.Uuid
  rating          Int
  title           String       @db.VarChar(100)
  body            String       @db.VarChar(2000)
  status          ReviewStatus @default(UNDER_MODERATION)
  /// Reasons the automatic checks held the review for a moderator, e.g. CONTAINS_LINK.
  moderationFlags String[]     @default([]) @map("moderation_flags")
  rejectionReason String?      @map("rejection_reason") @db.VarChar(300)
  /// Rating already counted in the product's average, so edits can adjust it exactly.
  countedRating   Int?         @map("counted_rating")
  publishedAt     DateTime?    @map("published_at")
  /// Where the review was written from, for fraud signals in Trust and safety (5.8).
  ip              String?      @db.VarChar(45)
  /// SHA-256 of the browser user agent and IP range.
  deviceHash      String?      @map("device_hash") @db.VarChar(64)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  media     ReviewMedia[]

  @@index([productId, status, publishedAt])
  @@index([userId, createdAt])
  @@map("reviews")
}

/// Photo or video for a review. Uploaded first, then attached when the review is saved.
model ReviewMedia {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  reviewId    String?         @map("review_id") @db.Uuid
  kind        ReviewMediaKind
  storageKey  String          @unique @map("storage_key") @db.VarChar(200)
  contentType String          @map("content_type") @db.VarChar(40)
  sizeBytes   Int             @map("size_bytes")
  createdAt   DateTime        @default(now()) @map("created_at")

  review Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reviewId])
  @@map("review_media")
}
