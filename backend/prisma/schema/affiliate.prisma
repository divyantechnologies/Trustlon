enum AffiliateEarningStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

/// A tracked share link for one product. Orders that follow a click earn the customer a commission.
model AffiliateLink {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  code      String   @unique @db.VarChar(12)
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  earnings AffiliateEarning[]

  @@unique([userId, productId])
  @@map("affiliate_links")
}

/// Commission on one ordered item. Confirmed only after the item's return window closes.
model AffiliateEarning {
  id              String                 @id @default(uuid()) @db.Uuid
  userId          String                 @map("user_id") @db.Uuid
  linkId          String?                @map("link_id") @db.Uuid
  orderNumber     String                 @map("order_number") @db.VarChar(20)
  productName     String                 @map("product_name") @db.VarChar(200)
  saleAmountPaise Int                    @map("sale_amount_paise")
  commissionPaise Int                    @map("commission_paise")
  status          AffiliateEarningStatus @default(PENDING)
  /// The return window end of the ordered item; the commission confirms after this.
  confirmAfter    DateTime               @map("confirm_after")
  confirmedAt     DateTime?              @map("confirmed_at")
  paidAt          DateTime?              @map("paid_at")
  createdAt       DateTime               @default(now()) @map("created_at")

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  link AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, confirmAfter])
  @@map("affiliate_earnings")
}
