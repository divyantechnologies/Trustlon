enum BusinessVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// B2B buyer profile. Bulk pricing and GST invoices with the buyer's GSTIN need VERIFIED.
model BusinessProfile {
  userId          String                     @id @map("user_id") @db.Uuid
  businessName    String                     @map("business_name") @db.VarChar(150)
  gstin           String                     @unique @db.Char(15)
  pan             String                     @db.Char(10)
  billingLine1    String                     @map("billing_line1") @db.VarChar(120)
  billingLine2    String?                    @map("billing_line2") @db.VarChar(120)
  billingCity     String                     @map("billing_city") @db.VarChar(80)
  billingState    String                     @map("billing_state") @db.VarChar(60)
  billingPincode  String                     @map("billing_pincode") @db.Char(6)
  status          BusinessVerificationStatus @default(PENDING)
  rejectionReason String?                    @map("rejection_reason") @db.VarChar(300)
  submittedAt     DateTime                   @default(now()) @map("submitted_at")
  verifiedAt      DateTime?                  @map("verified_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, submittedAt])
  @@map("business_profiles")
}
