# Server-side only. The browser calls /api/v1 on this app and Next.js forwards it to the API.
API_URL=http://localhost:4000

# Links from the admin panel to the other apps.
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
# Server-side address of the storefront, if different (used for Settings › Localisation).
STOREFRONT_URL=
# Optional. When set, "Open vendor dashboard" links to the vendor panel.
NEXT_PUBLIC_VENDOR_PANEL_URL=
