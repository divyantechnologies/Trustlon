# Server-side only. The browser calls /api/v1 on this app and Next.js forwards it to the API.
API_URL=http://localhost:4000

# Optional. The vendor panel's address. When set, "Start selling" on /sell opens its sign-up;
# when empty, the page collects the seller's details for the onboarding team instead.
NEXT_PUBLIC_VENDOR_PANEL_URL=

# Public address of the storefront, used in the sitemap, robots.txt and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
